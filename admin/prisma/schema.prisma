generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(USER)
  balance      Decimal   @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  apiKeys      ApiKey[]
  bills        Bill[]
  transactions Transaction[]
}

enum Role {
  ADMIN
  USER
}

model Provider {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  type      ProviderType
  baseUrl   String
  path      String         @default("/chat/completions")
  apiKey    String
  status    ProviderStatus @default(ACTIVE)
  createdAt DateTime       @default(now())

  models       Model[]
  usageRecords UsageRecord[]
}

enum ProviderType {
  OPENAI
  ANTHROPIC
  GOOGLE
  HUGGINGFACE
  DEEPSEEK
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
}

model Model {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  providerId Int
  provider   Provider  @relation(fields: [providerId], references: [id])
  status     String    @default("ACTIVE")
  inputPrice  Decimal @default(0)
  outputPrice Decimal @default(0)
  cachePrice  Decimal @default(0)
  createdAt  DateTime  @default(now())

  allowedKeys ApiKeyAllowedModel[]
}

model ApiKey {
  id           Int          @id @default(autoincrement())
  userId       Int
  user         User         @relation(fields: [userId], references: [id])
  keyHash      String       @unique
  name         String
  status       ApiKeyStatus @default(ACTIVE)
  rateLimit    Int          @default(60)
  dailyQuota   Int          @default(100000)
  monthlyQuota Int          @default(3000000)
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())

  usageRecords UsageRecord[]
  allowedModels ApiKeyAllowedModel[]
}

enum ApiKeyStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model ApiKeyAllowedModel {
  apiKeyId Int
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id])
  modelId  Int
  model    Model  @relation(fields: [modelId], references: [id])

  @@id([apiKeyId, modelId])
}

model UsageRecord {
  id        Int       @id @default(autoincrement())
  apiKeyId  Int
  apiKey    ApiKey    @relation(fields: [apiKeyId], references: [id])
  providerId Int
  provider  Provider  @relation(fields: [providerId], references: [id])
  model     String
  tokensIn  Int       @default(0)
  tokensOut Int       @default(0)
  cachedTokens Int     @default(0)
  cost      Decimal   @default(0)
  latencyMs Int       @default(0)
  createdAt DateTime  @default(now())
}

model Bill {
  id          Int        @id @default(autoincrement())
  userId      Int
  user        User       @relation(fields: [userId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  totalCost   Decimal   
  status      BillStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime   @default(now())
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
}

model Transaction {
  id          Int             @id @default(autoincrement())
  userId      Int
  user        User            @relation(fields: [userId], references: [id])
  type        TransactionType
  amount      Decimal        
  balance     Decimal        
  description String?
  createdAt   DateTime        @default(now())
}

enum TransactionType {
  RECHARGE
  CONSUMPTION
  REFUND
}
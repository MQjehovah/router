# Database (PostgreSQL)
POSTGRES_USER=ai_gateway
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=ai_gateway

# 运行环境:production/prod(大小写不敏感)下缺失或弱 secret 会拒绝启动;默认 development
APP_ENV=development

# CORS 白名单(逗号分隔,控制台/网关允许的浏览器来源);默认仅本机
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_SECRET=your_jwt_secret_key_here

# Internal
INTERNAL_SECRET=your_internal_secret_here

# Admin 会话(控制台 JWT)有效期,默认 12h
# 纯数字按"秒"解释(如 43200 = 12h);也接受 <n>s|m|h|d 时间跨度;须为正数,非法值启动即失败
ADMIN_SESSION_TTL=12h

# OIDC SSO（配置后 /internal/sso/exchange 才可用）
OIDC_ISSUER=https://idp.example.com
OIDC_AUDIENCE=router-admin
# 工号 claim 名，默认依次尝试 employee_number/employeeNumber/employee_id 等
OIDC_EMPLOYEE_ID_CLAIM=employee_number
# 可选：直接指定 JWKS 地址，跳过 discovery
# OIDC_JWKS_URI=https://idp.example.com/.well-known/jwks.json

# Encryption
ENCRYPTION_KEY=your_32_char_encryption_key

# Admin Password
ADMIN_PASSWORD=admin123

# Provider API Keys
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_API_KEY=your_google_api_key
HUGGINGFACE_API_KEY=your_huggingface_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key